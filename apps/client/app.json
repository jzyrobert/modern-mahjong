{
  "expo": {
    "name": "Modern Mahjong",
    "slug": "modern-mahjong",
    "version": "0.0.0",
    "scheme": "modernmahjong",
    "orientation": "default",
    "newArchEnabled": true,
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#4a6a47"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.modernmahjong.app",
      "requireFullScreen": true,
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.modernmahjong.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4a6a47"
      },
      "edgeToEdgeEnabled": true,
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-sqlite", "expo-asset"],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "450b36a7-da19-47a7-9b05-f8e924785bdb"
      },
      "serverUrl": "https://modern-mahjong-server.jzyrobert.workers.dev"
    },
    "owner": "robertjin"
  }
}
