# EAS uses this file in lieu of .gitignore when packaging the build
# tarball. The root .gitignore excludes `dist/` (a build artefact in
# every other workspace), but the expo-lan-server Android module's
# `stageLanBundleAssets` Gradle task copies `apps/client/dist/` into
# `assets/lan-bundle/` so the LAN host can serve the web client to
# browser guests. Without this override the prod APK ships without
# the bundle and `serveBundleAsset` returns the "LAN bundle missing"
# 404. The CI workflow runs `pnpm --filter @mahjong/client export-web`
# before `eas build`, so `dist/` exists at tarball time.

node_modules
.expo/
.expo-shared/
expo-env.d.ts

# Native shells — regenerated by `expo prebuild` during `eas build`.
/android/
/ios/

# Build / test outputs that aren't needed in the build payload.
build
.cache
.turbo
.parcel-cache
coverage
*.tsbuildinfo
*.log
test-results
playwright-report
.lighthouseci

# Local env files / secrets.
.env
.env.local
.wrangler
.dev.vars

# IDE / OS noise.
.DS_Store
Thumbs.db
.idea
.vscode
*.iml

# Claude Code per-user settings.
.claude/
