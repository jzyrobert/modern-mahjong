# EAS uses this file in lieu of .gitignore when packaging the build
# tarball. With monorepo support, `eas build --local` reads the
# ignore file from the **monorepo root** (where pnpm-workspace.yaml
# lives), NOT the workspace package directory — a previous attempt
# at `apps/client/.easignore` was a no-op for that reason.
#
# Why this matters: the expo-lan-server Android module's
# `stageLanBundleAssets` Gradle task copies `apps/client/dist/` into
# `assets/lan-bundle/` so the LAN host can serve the web client to
# browser guests. The root `.gitignore` excludes `dist/` (a build
# artefact in every other workspace), so without this override EAS
# strips `apps/client/dist/` out of the tarball, gradle's
# `onlyIf { dist.exists() }` short-circuits, and the prod APK ships
# without `assets/lan-bundle/`. At runtime the host serves a
# "LAN bundle missing — run pnpm --filter @mahjong/client export-web
# before eas build" 404 instead of the lobby.
#
# CI runs `pnpm --filter @mahjong/client export-web` before
# `eas build --local`, so `apps/client/dist/` exists at tarball time;
# this file is just the allowlist that lets it through.

node_modules

# Native shells regenerated by `expo prebuild` during `eas build`.
/apps/client/android
/apps/client/ios

# Build / test outputs that bloat the tarball with no benefit.
build
.cache
.turbo
.parcel-cache
coverage
*.tsbuildinfo
*.log
apps/client/test-results
apps/client/playwright-report
apps/client/.lighthouseci
.expo/
.expo-shared/
expo-env.d.ts

# Workspace dist/ outputs we don't want in the build payload — every
# `dist/` directory EXCEPT `apps/client/dist/`, which is the LAN
# bundle the gradle task needs to ship into the APK assets.
dist
!apps/client/dist
!apps/client/dist/**

# Local env / secrets. EAS Build resolves credentials via EXPO_TOKEN,
# not these files.
.env
.env.local
.wrangler
.dev.vars

# IDE / OS / per-user noise.
.DS_Store
Thumbs.db
.idea
.vscode
*.iml
.claude/
